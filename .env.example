# Copie este arquivo para .env.local e preencha os valores.
# Nunca faça commit do .env.local!

# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# E-mail que vai receber as mensagens do formulário de contato
CONTACT_TO_EMAIL=saradesousamagalhaes@gmail.com

# (Opcional) Remetente. Sem domínio verificado no Resend, use o padrão
# onboarding@resend.dev — nesse caso, CONTACT_TO_EMAIL precisa ser o
# mesmo e-mail da sua conta no Resend.
# CONTACT_FROM_EMAIL=Portfolio <contato@seudominio.com>
